{
  "name": "ai-eng-track",
  "build": { "dockerfile": "Dockerfile" },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false },
    // Lets you work from your own terminal instead of the browser: gh codespace ssh -c <name>
    "ghcr.io/devcontainers/features/sshd:1": {},
    // A custom devcontainer does not inherit the GitHub CLI the default Codespaces image has,
    // and every week ends in a pull request: gh pr create, gh run watch, gh pr view.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "docker compose up -d redis || true",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "API", "onAutoForward": "notify" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker"],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    },
    "codespaces": { "openFiles": ["weeks/0/README.md"] }
  },
  "secrets": {
    "GEMINI_API_KEY": { "description": "Default provider. Free key, no card: https://aistudio.google.com/apikey" },
    "GROQ_API_KEY": { "description": "Optional second provider for the Week 1 switch: https://console.groq.com/keys" }
  }
}
