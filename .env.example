# --- Model access: the ONLY thing you change to move between providers ---
# Providers known to app/llm/registry.py: gemini, groq, openrouter, cerebras, mistral, openai, fake_a, fake_b
MODEL_PROVIDER=gemini
# Leave MODEL_NAME empty to take the provider's default model (gemini-3.5-flash-lite)
MODEL_NAME=
# Free key, no card: https://aistudio.google.com/apikey  (or set GEMINI_API_KEY as a Codespaces secret)
MODEL_API_KEY=
# Optional: tried when the primary provider exhausts its retries (quota, 429, 5xx)
MODEL_FALLBACK_PROVIDER=
MODEL_FALLBACK_API_KEY=

# --- Model call behaviour ---
MODEL_TIMEOUT_S=20
MODEL_RETRY_ATTEMPTS=3
MODEL_RETRY_BASE_DELAY_S=0.5
MAX_INPUT_CHARS=24000

# --- Storage and jobs ---
DATABASE_URL=sqlite:///./data/app.db
# Leave empty to run jobs in-process; set to use the Redis worker (docker compose up -d redis)
REDIS_URL=

# --- Week 2+: retrieval ---
# hash = lexical, no download (CI). fastembed = BAAI/bge-small-en-v1.5 on CPU, ~130 MB once.
EMBED_PROVIDER=hash
# fixed | sentence | paragraph | heading  (pick one with a number: scripts/retrieval_eval.py)
CHUNK_STRATEGY=sentence
SEARCH_K=5
# Week 3: below this cosine score the system abstains rather than answers
RELEVANCE_THRESHOLD=0.30

# --- Week 4+: agents ---
AGENT_MAX_STEPS=8
REQUIRE_APPROVAL_FOR_COST=true

# --- Week 5+: guardrails ---
GUARD_ENABLED=true
KILL_SWITCH=false
DAILY_BUDGET_USD=1.00

# --- Week 6: shipping ---
APP_VERSION=0.1.0
GIT_SHA=dev
# --- Hub page playground ---
# Browser origins allowed to call the API. * for learning; narrow it later.
CORS_ORIGINS=*
